{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push origin main)",
      "Bash(git push origin main *)",
      "Bash(git push origin HEAD:main)",
      "Bash(git push origin HEAD:main *)"
    ],
    "ask": [
      "Edit(/.specify/memory/constitution.md)",
      "Edit(/process/**)",
      "Edit(/.specify/extensions/**)",
      "Edit(/.github/**)",
      "Edit(/CLAUDE.md)",
      "Edit(/product/vocabulary-denylist.txt)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/hooks/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "if command -v python >/dev/null 2>&1; then py=python; else py=python3; fi; \"$py\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_bash.py\"",
            "timeout": 15,
            "statusMessage": "Checking command against charter guardrails"
          }
        ]
      }
    ]
  }
}
